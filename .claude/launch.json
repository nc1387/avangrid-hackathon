{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "battery-web",
      "runtimeExecutable": "/opt/anaconda3/bin/uvicorn",
      "runtimeArgs": [
        "app.server:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "battery-simulator",
      "runtimeExecutable": "/opt/anaconda3/bin/streamlit",
      "runtimeArgs": [
        "run",
        "app/battery_simulator.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true"
      ],
      "port": 8501
    }
  ]
}